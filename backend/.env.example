PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/proveit
# Promote existing accounts listed here to admin after each API startup.
# Create the account first, then add its email here and restart the API.
ADMIN_EMAILS=
BADGE_SECRET=change-me-to-any-long-random-string
PUBLIC_URL=http://localhost:5173
# AI providers: any OpenAI-compatible /chat/completions API. Fill AI_* first; AI2_* and AI3_* are optional fallbacks.
# Example base URLs (check each provider's docs for the current value and free model names):
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   Groq: https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI2_BASE_URL=
AI2_API_KEY=
AI2_MODEL=
AI3_BASE_URL=
AI3_API_KEY=
AI3_MODEL=
# 1 = never call an AI, return canned answers (use while building, or as a demo safety net)
AI_MOCK=0
# 1 = if every provider fails, fall back to canned answers so the demo never dies. 0 = throw instead.
AI_FALLBACK_MOCK=1
GRADE_RUNS=3
AI_TIMEOUT_MS=45000
# Seed safety: set these explicitly only for a local/demo database.
# PROVEIT_ENV=local
# PROVEIT_SEED_CONFIRM=LOCAL_DEMO
